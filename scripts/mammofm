#!/usr/bin/env bash
# One entrypoint for SCC. Usage: mammofm submit | submit-cpu | status | tunnel | verify | log
#   verify-cpu | verify-8bit | verify-all | autopilot-run | autopilot-submit
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DATA="${MAMMOFM_DATA:-/restricted/projectnb/batmanlab/atang4/data}"
JUMP="${MAMMOFM_JUMP:-atang4@scc1.bu.edu}"
LOGIN="${MAMMOFM_LOGIN:-atang4@scc4.bu.edu}"
PY="${MAMMOFM_PYTHON:-/restricted/projectnb/batmanlab/shawn24/llava_breast/bin/python3.10}"

help() {
  echo "MammoFM — use this instead of remembering paths."
  echo ""
  echo "  $0 submit      — qsub web server; Stage 1 on GPU (default in start_server.sh)"
  echo "  $0 submit-cpu  — same, but Stage 1 decode on CPU (slow; reliable if GPU OOM)."
  echo "                    Optional: MAMMOFM_STAGE1_MAX_NEW_TOKENS=64 $0 submit-cpu"
  echo "                    8/4-bit Stage 1 stays on GPU (incompatible with CPU merge path)."
  echo "                    Reference: $ROOT/scripts/STAGE1_CPU_FALLBACK.md"
  echo "  $0 status  — qstat + last server_info.txt (wait until job state is r / running)"
  echo "  $0 tunnel  — print SSH + URL (run the ssh line on your laptop)"
  echo "  $0 log     — optional: tail -f server.log (debug only)"
  echo "  $0 verify  — backend paths + Stage 1 patch hooks + Llama offline cache (no GPU)"
  echo "               (set MAMMOFM_SKIP_LLAMA_CACHE_CHECK=1 on login nodes without hub snapshot)"
  echo ""
  echo "Stage 1 tests (qsub on SCC):"
  echo "  qsub $ROOT/scripts/smoke_test_stage1_patch.sh   # e2e, GPU Stage 1 by default (may OOM on 16GB)"
  echo "  qsub -v SMOKE_CPU_STAGE1=1 $ROOT/scripts/smoke_test_stage1_patch.sh   # CPU Stage 1 (slow, reliable)"
  echo "  qsub $ROOT/scripts/smoke_test_stage1_8bit_load_only.sh # 8-bit load canary only"
  echo ""
  echo "Verification (pathway smoke tests):"
  echo "  $0 verify-cpu    — qsub CPU+GPU pathway (Stage1 fp16 on CPU, Stage2 on GPU); verify_cpu.{OK,FAIL}"
  echo "  $0 verify-fp16   — qsub 16-bit GPU pathway on A100/A40-class; verify_fp16.{OK,FAIL}"
  echo "  $0 verify-8bit   — qsub 8-bit GPU pathway on A100/A40-class; verify_8bit.{OK,FAIL}"
  echo "  $0 verify-all    — qsub all three; prints all job ids"
  echo ""
  echo "Autopilot (runs both verify jobs, monitors, self-heals, then tests the full webapp):"
  echo "  $0 autopilot-submit  — qsub the autopilot to a CPU node (survives SSH disconnect)"
  echo "  $0 autopilot-run     — run the autopilot in the foreground (use in tmux)"
  echo "    HARNESS_MAX_RETRIES=3  HARNESS_POLL_INTERVAL=60  (env-configurable)"
  echo ""
  echo "After submit: ./scripts/mammofm status until your job is running, then ./scripts/mammofm tunnel,"
  echo "run the printed ssh on your **laptop** (leave it open), open the URL — not on SCC."
  echo "Optional: LOCAL_PORT=25002 $0 tunnel   if the default local port is busy."
}

case "${1:-help}" in
  submit)
    qsub "$ROOT/scripts/start_server.sh"
    echo ""
    echo "Next:  $0 status   (repeat until qstat shows state r)"
    echo "Then:  $0 tunnel  (copy ssh to laptop)"
    ;;
  submit-cpu)
    _v="MAMMOFM_STAGE1_CPU_GENERATE=1"
    if [[ -n "${MAMMOFM_STAGE1_MAX_NEW_TOKENS:-}" ]]; then
      _v="${_v},MAMMOFM_STAGE1_MAX_NEW_TOKENS=${MAMMOFM_STAGE1_MAX_NEW_TOKENS}"
    fi
    qsub -v "$_v" "$ROOT/scripts/start_server.sh"
    echo ""
    echo "Next:  $0 status   (repeat until qstat shows state r)"
    echo "Then:  $0 tunnel  (copy ssh to laptop)"
    ;;
  status)
    qstat -u "$USER" 2>/dev/null || true
    echo "---"
    if [[ -f "$DATA/server_info.txt" ]]; then cat "$DATA/server_info.txt"
    else echo "No $DATA/server_info.txt yet (job not started or first boot)."
    fi
    ;;
  log)
    exec tail -f "$DATA/server.log"
    ;;
  tunnel)
    node=""
    [[ -f "$DATA/server_info.txt" ]] && node=$(grep '^Node:' "$DATA/server_info.txt" | awk '{print $2}' || true)
    if [[ -z "${node:-}" ]]; then
      echo "No compute node in server_info.txt — job may still be queued. Try: $0 status"
      exit 1
    fi
    # Avoid ~/.ssh/config ControlMaster and IDE port grabs; high local port avoids 8000–8002 clashes.
    lp="${LOCAL_PORT:-25001}"
    echo "On your LAPTOP (new terminal), leave running:"
    echo ""
    echo "  ssh -F /dev/null -S none -o ControlMaster=no -N -J $JUMP -L ${lp}:${node}:8000 $LOGIN"
    echo ""
    echo "Browser:  http://127.0.0.1:${lp}"
    echo "If the node name fails from scc4, use host ${node}.bu.edu in place of ${node} in -L."
    echo "(Use LOCAL_PORT=25002 $0 tunnel if $lp is busy.)"
    ;;
  verify)
    cd "$ROOT/backend"
    PYTHONPATH=. "$PY" verify_backend.py
    PYTHONPATH=. "$PY" verify_sitecustomize_stage1.py
    ;;
  verify-cpu)
    JID=$(qsub -terse "$ROOT/scripts/smoke_e2e_cpu.sh")
    echo "CPU+GPU verification submitted: job $JID"
    echo "Monitor: qstat -j $JID"
    echo "Sentinel: /restricted/projectnb/batmanlab/atang4/data/validation/verify_cpu.OK"
    ;;
  verify-fp16)
    JID=$(qsub -terse "$ROOT/scripts/smoke_e2e_fp16_a100.sh")
    echo "16-bit GPU (A100) verification submitted: job $JID"
    echo "Monitor: qstat -j $JID"
    echo "Sentinel: /restricted/projectnb/batmanlab/atang4/data/validation/verify_fp16.OK"
    ;;
  verify-8bit)
    JID=$(qsub -terse "$ROOT/scripts/smoke_e2e_a100.sh")
    echo "8-bit GPU verification submitted: job $JID"
    echo "Monitor: qstat -j $JID"
    echo "Sentinel: /restricted/projectnb/batmanlab/atang4/data/validation/verify_8bit.OK"
    ;;
  verify-all)
    JID_CPU=$(qsub -terse "$ROOT/scripts/smoke_e2e_cpu.sh")
    JID_FP16=$(qsub -terse "$ROOT/scripts/smoke_e2e_fp16_a100.sh")
    JID_8BIT=$(qsub -terse "$ROOT/scripts/smoke_e2e_a100.sh")
    echo "CPU+GPU verification: job $JID_CPU"
    echo "fp16 verification:   job $JID_FP16"
    echo "8bit verification:   job $JID_8BIT"
    echo "Monitor: qstat -u $USER"
    ;;
  autopilot-run)
    exec "$ROOT/harness/autopilot.sh" "$@"
    ;;
  autopilot-submit)
    RUN_DIR="$ROOT/harness/runs/$(date +%Y%m%d_%H%M%S)"
    mkdir -p "$RUN_DIR"
    JID=$(qsub -terse \
      -l h_rt=48:00:00 \
      -N mammofm-autopilot \
      -j y \
      -o "$RUN_DIR/autopilot.log" \
      -b y \
      "${BASH_SOURCE[0]}" autopilot-run)
    echo "Autopilot submitted: job $JID"
    echo "Run dir: $RUN_DIR"
    echo ""
    echo "Monitor from anywhere on SCC:"
    echo "  qstat -j $JID"
    echo "  tail -f $RUN_DIR/autopilot.log"
    echo "  cat  $RUN_DIR/state.json"
    echo "  cat  $RUN_DIR/report.md    # final summary when done"
    echo "  qdel $JID                  # to stop early"
    ;;
  help|-h|--help)
    help
    ;;
  *)
    help
    exit 1
    ;;
esac
